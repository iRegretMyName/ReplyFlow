# Copy this file to .env and fill in your values. Never commit .env.
GEMINI_API_KEY=your_key_here
# Check Google AI Studio for the currently available free model name.
GEMINI_MODEL=gemini-2.0-flash
PORT=3001

# ---- Sign-in and sessions (all optional; the defaults are sensible) ----
# Set to production when the site is served over HTTPS. Cookies then become "Secure".
# NODE_ENV=production
# Running a production build over plain http on a trusted network only (never the public internet):
# COOKIE_SECURE=false
# Sign out after this many minutes without activity (default 120) / hours in total (default 12).
# SESSION_IDLE_MINUTES=120
# SESSION_MAX_HOURS=12
# Behind a reverse proxy (nginx, a hosting platform)? Number of proxies in front of the server,
# so each visitor's real address is used for sign-in rate limiting.
# TRUST_PROXY=1
# Extra site addresses allowed to call the API, comma separated. Normally leave unset.
# ALLOWED_ORIGINS=https://desk.example.com
# How many website enquiries one visitor address may send per hour (default 5).
# ENQUIRY_LIMIT_PER_HOUR=5
